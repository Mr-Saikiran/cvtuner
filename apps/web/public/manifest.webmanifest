{
  "name": "CVTuner by TechSwitch",
  "short_name": "CVTuner",
  "description": "Tune your resume to any job description.",
  "start_url": "/cvtuner",
  "scope": "/cvtuner/",
  "display": "standalone",
  "background_color": "#f6f7fb",
  "theme_color": "#2a56d6",
  "icons": [
    {
      "src": "/cvtuner/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/cvtuner/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/cvtuner/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/cvtuner/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}