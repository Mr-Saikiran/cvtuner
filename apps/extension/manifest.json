{
  "manifest_version": 3,
  "name": "CVTuner: tune your resume for any job",
  "version": "1.1.0",
  "description": "Adds \"Tune with CVTuner\" and \"Save to tracker\" to job pages on LinkedIn, Naukri and Indeed, and sends any other job page with one click.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "action": {
    "default_title": "Send this job to CVTuner",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://*.naukri.com/*", "https://*.indeed.com/*", "https://indeed.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
